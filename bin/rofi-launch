#!/bin/sh
# rofi-launch — single-instance toggle для drun-лончера (SUPER+SHIFT+D) + закрытие по клику-мимо.
# Повторный вызов при открытом rofi ЗАКРЫВАЕТ его (не плодит копии — болячка wofi).
# На время жизни rofi вешаем closer (bindn mouse:272), чтобы клик по ПУСТОМУ столу тоже закрывал.
if pkill -x rofi; then
    exit 0
fi
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"; export XDG_RUNTIME_DIR
[ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] || \
  export HYPRLAND_INSTANCE_SIGNATURE=$(ls -t "$XDG_RUNTIME_DIR"/hypr/ 2>/dev/null | grep -v '\.lock' | head -1)
hyprctl keyword bindn ",mouse:272,exec,$HOME/.local/bin/rofi-outside-close" >/dev/null 2>&1
uwsm app -- rofi -show drun
hyprctl keyword unbind ",mouse:272" >/dev/null 2>&1
