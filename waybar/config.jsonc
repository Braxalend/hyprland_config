// Waybar — matrix-зелёный монитор системы.
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 2,
    "modules-left": ["hyprland/workspaces", "custom/winclass"],
    "modules-center": ["clock"],
    "modules-right": [
        "tray", "cpu", "memory", "temperature", "pulseaudio", "custom/extip",
        "custom/clip", "custom/layout", "battery", "custom/ac", "custom/power"
    ],

    "hyprland/workspaces": {
        "on-click": "activate",
        "format": "{id}",
        "all-outputs": true
    },

    "custom/winclass": {
        "exec": "~/.local/bin/win-icon",
        "interval": 1,
        "format": "{}",
        "tooltip": false
    },

    // --- wlr/taskbar убран: вешал терминал при клике ---
    // // Панель задач: иконки ВСЕХ окон (вкл. свёрнутые в special:minimized).
    // // Клик = фокус/показ окна (свёрнутое всплывает оверлеем спец-воркспейса).
    // // Средняя кнопка = закрыть. all-outputs:false → окна своего монитора.
    // "wlr/taskbar": {
    // "format": "{icon}",
    // "icon-size": 18,
    // "icon-theme": "Yaru",
    // "tooltip-format": "{title}",
    // "on-click": "activate",
    // "on-click-middle": "close",
    // "all-outputs": false,
    // "active-first": false,
    // "ignore-list": []
    // },

    "custom/layout": {
        "exec": "~/.local/bin/layout-indicator",
        "interval": 1,
        "format": "{}",
        "tooltip": false,
        "on-click": "hyprctl switchxkblayout all next"
    },

    "clock": {
        "interval": 1,
        "locale": "ru_RU_nom.UTF-8",
        "format": "{:L%a %d.%m.%Y  %H:%M:%S}",
        "format-alt": "{:%H:%M:%S}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months":   "{}",
                "days":     "<span color='#b8b8b8'>{}</span>",
                "weekdays": "<span color='#000000' background='#00ff41'><b>{}</b></span>\n",
                "today":    "<span color='#000000' background='#00ff41'><b>{}</b></span>"
            }
        }
    },

    "cpu": {
        "interval": 2,
        "format": " {usage} %",
        "tooltip": true,
        "on-click": "foot -e btop 2>/dev/null || foot -e top"
    },

    "memory": {
        "interval": 2,
        "format": " {percentage} %",
        "on-click": "foot -e btop 2>/dev/null || foot -e top",
        "tooltip-format": "RAM {used:0.1f}G / {total:0.1f}G  swap {swapUsed:0.1f}G"
    },

    "temperature": {
        "thermal-zone": 0,
        "interval": 2,
        "critical-threshold": 85,
        "format": " {temperatureC} °C",
        "format-critical": " {temperatureC} °C",
        "on-click": "foot -e btop 2>/dev/null || foot -e top",
        "tooltip": true
    },

    "custom/clip": {
        "format": "󰆒",
        "tooltip-format": "История буфера обмена (cliphist)",
        "on-click": "sh -c 'cliphist list | fuzzel --dmenu | cliphist decode | wl-copy'"
    },

    "custom/extip": {
        "exec": "~/.local/bin/net-status",
        "return-type": "json",
        "interval": 120,
        "signal": 8,
        "format": "{}",
        "on-click": "~/.local/bin/net-menu",
        "on-click-right": "nm-connection-editor"
    },

    "battery": {
        "interval": 30,
        "states": { "warning": 20, "critical": 10 },
        "format": "{icon} {capacity} %",
        "format-charging": "{icon} {capacity} %",
        "format-plugged": "{icon} {capacity} %",
        "format-icons": ["", "", "", "", ""],
        "on-click": "~/.local/bin/powerprofile-menu",
        "tooltip-format": "{timeTo} · {power}W\nПрофиль питания — клик"
    },

    "custom/ac": {
        "exec": "~/.local/bin/ac-indicator",
        "return-type": "json",
        "interval": 5,
        "format": "{}"
    },

    "pulseaudio": {
        "format": "{icon} {volume} %",
        "format-muted": " mute",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 4
    },

    "custom/power": {
        "exec": "~/.local/bin/power-glyph",
        "interval": 100000,
        "format": "{}",
        "tooltip": true,
        "tooltip-format": "Питание: выход / перезагрузка / выключение",
        "on-click": "~/.local/bin/power-menu"
    }
}
